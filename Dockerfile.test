# Use the .NET SDK image to build and run unit tests
FROM mcr.microsoft.com/dotnet/sdk:10.0 AS testrunner
WORKDIR /app

# Copy solution and project files first to cache NuGet restore
COPY AcasSimulator.slnx ./
COPY AcasSimulator/AcasSimulator.csproj AcasSimulator/
COPY AcasSimulator.Tests/AcasSimulator.Tests.csproj AcasSimulator.Tests/

# Restore dependencies (Cached unless .csproj changes)
RUN dotnet restore

# Copy actual source code (Ignored bin/obj via .dockerignore)
COPY . ./

# Build and run tests
ENTRYPOINT ["dotnet", "test", "--logger:console;verbosity=normal"]